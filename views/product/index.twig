{% extends 'layouts/home.twig' %}

{% block pageName %}View All Galaxies{% endblock %}

{% block main %}
  <h1>All Galaxies:</h1>
  {% if galaxies %}
    <ul>
      {% for galaxy in galaxies %}
        <li>
          {{ galaxy.name }} - 
          <a href="galaxies/{{ galaxy.id }}">View Galaxy</a> | 
          <a href="galaxies/{{ galaxy.id }}/edit">Edit Galaxy</a> | 
          <a href="galaxies/{{ galaxy.id }}/delete">Delete Galaxy</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No galaxies to display.</p>
  {% endif %}

  <a href="galaxies/new">Create New Galaxy</a>
{% endblock %}